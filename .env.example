# Copy to .env and replace only the providers you use. Never commit .env.
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me

# Logical provider order. Numbered Gemini slots are expanded automatically.
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github
GLC_PORT=8111

# Per-call ledger. Defaults to ~/.glc/gateway.sqlite, which every GLC generation
# on the machine shares. Set this if an earlier generation already created that
# file: its `calls` table has NOT NULL schema_version/event_id/signature columns
# this gateway never writes, the CREATE TABLE IF NOT EXISTS no-ops against it,
# and each /v1/chat then dies at insert with
#   sqlite3.IntegrityError: NOT NULL constraint failed: calls.schema_version
# surfacing as a 500 while /healthz still passes. Give this generation its own
# file rather than migrating the old one — it is an append-only audit ledger.
# Absolute path required: ~ is not expanded for this variable.
# GLC_GATEWAY_DB=/Users/you/.glc/glc_v5/gateway.sqlite

# S16 channel bridge. Use the same private value in S16_CHANNEL_BRIDGE_TOKEN.
S16_BASE_URL=http://127.0.0.1:8113
GLC_S16_BRIDGE_TOKEN=replace-with-a-long-random-local-token
GLC_S16_TIMEOUT=180
